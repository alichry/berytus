# syntax=docker/dockerfile:1.7
# escape=`
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

WORKDIR C:\berytus
COPY port C:\berytus\port
COPY mozilla-unified C:\berytus\mozilla-unified\

# Run port export under Git Bash. port is a POSIX sh script.
SHELL ["cmd", "/S", "/C"]
RUN bash -lc "/c/berytus/port export \"$(cygpath -u \"%MOZ_DIR%\")\""

# Install Berytus toolkit + secretstar npm deps.
RUN cd /d "%MOZ_DIR%\toolkit\components\berytus" && npm install && `
    cd /d "%MOZ_DIR%\browser\extensions\secretstar" && npm install

# Build under the MSVC environment. mozconfig was written by the base image
# and pins --with-ccache=sccache.
RUN call "%VS_BUILDTOOLS%\VC\Auxiliary\Build\vcvars64.bat" && `
    cd /d "%MOZ_DIR%\toolkit\components\berytus" && npm run build && `
    cd /d "%MOZ_DIR%\browser\extensions\secretstar" && set CI=false&& npm run build && `
    cd /d "%MOZ_DIR%\browser\extensions\secretstar" && bash -lc "./moz.build.sh" && `
    cd /d "%MOZ_DIR%" && mach build && sccache --show-stats

# Regenerate WPT certificates. Same OpenSSL recipe as Linux/macOS; Git's
# bundled OpenSSL supports -addext / -copy_extensions.
RUN bash -lc "set -e; cd \"$(cygpath -u \"%MOZ_DIR%\")/testing/web-platform/tests\"; `
    echo 'Current CA cert validity:'; `
    openssl x509 -in tools/certs/cacert.pem -noout -dates; `
    echo 'Current Server cert validity:'; `
    openssl x509 -in tools/certs/web-platform.test.pem -noout -dates; `
    CA_SAN=$(openssl x509 -in tools/certs/cacert.pem -noout -ext subjectAltName | tail -1 | sed 's/^[[:space:]]*//'); `
    CA_NC=$(openssl x509 -in tools/certs/cacert.pem -noout -ext nameConstraints | tail +3 | sed 's/^[[:space:]]*//' | awk '{printf \"permitted;%%s\\n\", $0}'); `
    openssl req -x509 -newkey rsa:2048 `
        -keyout tools/certs/cacert.key -out tools/certs/cacert.pem `
        -days 365 -nodes -subj '/CN=web-platform-tests' `
        -addext 'basicConstraints = critical, CA:TRUE' `
        -addext 'keyUsage = keyCertSign' `
        -addext 'extendedKeyUsage = serverAuth' `
        -addext 'authorityKeyIdentifier = keyid:always, issuer:always' `
        -addext \"subjectAltName = $CA_SAN\" `
        -addext \"nameConstraints = $(echo \"$CA_NC\" | paste -sd',' -)\"; `
    openssl req -newkey rsa:2048 `
        -keyout tools/certs/web-platform.test.key `
        -out /tmp/wpt.csr `
        -nodes -subj '/CN=web-platform.test' `
        -addext 'basicConstraints=CA:FALSE' `
        -addext 'keyUsage=digitalSignature,nonRepudiation,keyEncipherment' `
        -addext 'extendedKeyUsage=serverAuth' `
        -addext \"subjectAltName=$CA_SAN\"; `
    openssl x509 -req -in /tmp/wpt.csr `
        -CA tools/certs/cacert.pem -CAkey tools/certs/cacert.key `
        -CAcreateserial -out tools/certs/web-platform.test.pem -days 365 `
        -copy_extensions copy; `
    rm -f /tmp/wpt.csr; `
    echo 'New CA cert validity:'; `
    openssl x509 -in tools/certs/cacert.pem -noout -dates; `
    echo 'New Server cert validity:'; `
    openssl x509 -in tools/certs/web-platform.test.pem -noout -dates"

# Fix typing_extensions for WPT. The current, bundled typing_extensions at
# testing/web-platform/tests/tools/third_party/ is too old (missing
# `deprecated`, added in 4.5.0), causing mach wpt to fail. By removing the
# bundled version (4.1.1), mach wpt will install a newer version via pip.
# This probably needs to be removed once we use a newer (and stable)
# mozilla-unified changeset.
RUN if exist "%MOZ_DIR%\testing\web-platform\tests\tools\third_party\typing_extensions" `
        rmdir /s /q "%MOZ_DIR%\testing\web-platform\tests\tools\third_party\typing_extensions"

WORKDIR C:\build\mozilla-unified

# Wrap mach in vcvars64 so callers (test/package jobs) get the MSVC env.
COPY --chmod=0755 <<'EOF' C:/berytus/mach.cmd
@echo off
call "%VS_BUILDTOOLS%\VC\Auxiliary\Build\vcvars64.bat" >NUL
cd /d "%MOZ_DIR%"
mach %*
EOF

ENTRYPOINT ["C:\\berytus\\mach.cmd"]

{
  "name": "berytus",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=25.5.6"
  },
  "scripts": {
    "proxy": "/bin/sh -c 'echo \"You might be prompted to enter your password in 3 seconds\"; sleep 3; echo \"Starting (sudo) socat proxy $PROXY_PORT --> $LISTEN_PORT\"; sudo socat tcp-listen:$PROXY_PORT,reuseaddr,fork tcp:localhost:$LISTEN_PORT'",
    "dev:server": "/bin/sh -c 'astro dev --port $LISTEN_PORT < /dev/null'",
    "dev": "npm-run-all -l -n --parallel dev:server proxy",
    "build:node": "astro check && astro build",
    "build:netlify": "BUILD_TARGET=netlify astro check && BUILD_TARGET=netlify astro build",
    "preview": "astro preview",
    "astro": "astro",
    "start": "NODE_ENV=production node ./run-server.mjs",
    "generate-webidl-ts": "./generate-webidl-ts.sh",
    "dev:flyway": "./src/bin/flyway.ts",
    "dev:flyway:migrate": "./src/bin/migrate-db.ts",
    "test": "NODE_ENV=development mocha test/prepare-env.ts test/prepare-db.ts test/suite/**/*.test.ts",
    "netlify": "netlify"
  },
  "dependencies": {
    "@astrojs/alpinejs": "^0.4.9",
    "@astrojs/check": "^0.9.6",
    "@astrojs/netlify": "^6.6.3",
    "@astrojs/node": "^9.5.1",
    "@astrojs/preact": "^4.1.3",
    "@astrojs/tailwind": "^6.0.2",
    "@citation-js/plugin-bibtex": "^0.7.8",
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@types/alpinejs": "^3.13.5",
    "@typescript-eslint/typescript-estree": "^6.21.0",
    "alpinejs": "^3.13.3",
    "astro": "^5.16.4",
    "canonical-json": "^0.4.0",
    "citation-js": "^0.7.8",
    "codemirror": "^6.0.1",
    "express": "^4.19.2",
    "jose": "^6.1.3",
    "monaco-editor": "^0.46.0",
    "morgan": "^1.10.0",
    "mysql2": "^3.9.7",
    "object-path": "^0.11.8",
    "postgres": "^3.4.7",
    "preact": "^10.19.3",
    "prettier": "3.2.5",
    "sqlite3": "^5.1.7",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/chai": "^4.3.16",
    "@types/chai-as-promised": "^7.1.8",
    "@types/data-urls": "^3.0.4",
    "@types/express": "^4.17.21",
    "@types/mocha": "^10.0.6",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.12.12",
    "@types/object-path": "^0.11.4",
    "chai": "^5.1.1",
    "chai-as-promised": "^7.1.2",
    "mocha": "^10.4.0",
    "netlify-cli": "^23.12.3",
    "npm-run-all": "^4.1.5",
    "ts-node": "^10.9.2",
    "ts-paths-esm-loader": "^1.4.3",
    "webidl-dts-gen": "^1.7.0"
  }
}
